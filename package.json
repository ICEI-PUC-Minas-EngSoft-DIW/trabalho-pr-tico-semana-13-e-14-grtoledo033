async function carregarDados() {
  const resposta = await fetch("http://localhost:3000/itens"); 
  const dados = await resposta.json();
  return dados;
}

async function montarGraficoCategorias() {
  const dados = await carregarDados();

  // Agrupar categorias
  const contagem = {};

  dados.forEach(item => {
    if (!contagem[item.categoria]) {
      contagem[item.categoria] = 0;
    }
    contagem[item.categoria]++;
  });

  // Preparar dados para o Chart.js
  const labels = Object.keys(contagem);
  const valores = Object.values(contagem);

  const ctx = document.getElementById("graficoCategorias");

  new Chart(ctx, {
    type: "bar",
    data: {
      labels: labels,
      datasets: [{
        label: "Quantidade de Itens por Categoria",
        data: valores
      }]
    }
  });
}

montarGraficoCategorias();


